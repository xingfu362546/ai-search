<mxfile host="app.diagrams.net" type="device"><diagram id="p1" name="数据源双通道选型"><mxGraphModel dx="1700" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c_title" value="子流检索节点的数据源选型：按「数据是否会变」分成三种通道" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1440" height="46" as="geometry"/></mxCell><mxCell id="c_hA" value="通道 A｜HTTP 接口&#10;动态数据 · 必须实时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="460" height="66" as="geometry"/></mxCell><mxCell id="c_hB" value="通道 B｜知识库检索&#10;静态元数据 · 语义召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="460" height="66" as="geometry"/></mxCell><mxCell id="c_hC" value="通道 C｜知识库召回 + HTTP 校验&#10;目录靠召回 · 数值靠接口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="90" width="460" height="66" as="geometry"/></mxCell><mxCell id="c_a0" value="线下课程：期数 · 开课日期 · 剩余名额" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_a1" value="线上课程：价格 · 是否在售 · 购买人数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_a2" value="领袖营：营期 · 剩余名额 · 报名状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="328" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_a3" value="6Q商城：价格 · 库存 · 上下架状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_b0" value="文章：标题 · 摘要 · 封面 · 跳转链接" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="176" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_b1" value="视频：标题 · 封面 · 时长 · 播放页链接" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="252" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_b2" value="音频：标题 · 封面 · 时长 · 专辑信息" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="328" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_b3" value="高EQ导师：姓名 · 擅长 · 简介 · 头像链接" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="404" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_c0" value="6Q商城：知识库出商品目录 → 接口补价格库存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="176" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_c1" value="线上课程：知识库出课程名 → 接口补价格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="252" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_c2" value="线下课程：知识库出课名 → 接口出期数（现状已这么做）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="328" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_c3" value="注意：知识库只负责「有哪些」，不负责「多少钱」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="404" width="460" height="62" as="geometry"/></mxCell><mxCell id="c_parse" value="统一解析节点（每类一个 code 节点）&#10;知识库 chunk / HTTP body → 卡片字段&#10;强制包含 type 与 url，缺则不出卡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="760" height="78" as="geometry"/></mxCell><mxCell id="c_red" value="红线&#10;期数 · 名额 · 价格 · 库存这类数值，只能来自 HTTP。&#10;知识库与模型都不得生成或推算，缺失时该字段留空、不展示。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="760" height="76" as="geometry"/></mxCell><mxCell id="c_note" value="为什么内容类可以用知识库&#10;· 文章 / 视频 / 音频 / 导师的元数据变化低频，天级同步足够&#10;· 检索诉求是「语义相关」而非「精确筛选」，正好是向量检索强项&#10;· 无需等后端排期，可先用知识库把 4 类跑通&#10;&#10;为什么商城必须走接口&#10;· 价格、库存、上下架是秒级变化，知识库跟不上&#10;· 用户要的是「能买到的」，语义召回解决不了&#10;· 价格区间这类结构化筛选知识库做不了" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;size=14;" vertex="1" parent="1"><mxGeometry x="1190" y="520" width="480" height="200" as="geometry"/></mxCell><mxCell id="ce1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_hA" target="c_a0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" sou