<mxfile host="app.diagrams.net" type="device"><diagram id="p1" name="v6 子流标准结构"><mxGraphModel dx="1620" dy="420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane1" value="子流标准结构（8 类共用同一模板，以线下课程为例）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#d0d0d0;verticalAlign=top;align=left;fontSize=11;fontColor=#9a9a9a;dashed=1;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1560" height="300" as="geometry"/></mxCell><mxCell id="s_in" value="子流入口&#10;继承 intents / slots / shown_ids" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1a1a1a;fontColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="s_kb" value="知识库 课程归一化&#10;仅课程类需要；内容类可跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="s_parse" value="代码 解析归一化结果&#10;course_id / 全称 / 亮点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="200" height="80" as="geometry"/></mxCell><mxCell id="s_judge" value="判断 是否可直接检索&#10;single / multiple / none" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="200" height="80" as="geometry"/></mxCell><mxCell id="s_http" value="HTTP 检索接口&#10;URL / 参数：待开发提供" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="210" height="80" as="geometry"/></mxCell><mxCell id="s_parse